APP_NAME="كلية العلوم - جامعة طرابلس"
APP_ENV=production
APP_KEY=base64:fv7mN5uMeIa5a2bnSyoA3/Wq9A7XkFhXMdxz7bqvAeI=
APP_DEBUG=false
APP_URL=https://uot-science-inquiries.onrender.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# قاعدة البيانات (Database):
# افتراضياً SQLite يعمل تلقائياً وبدون أي إعدادات إضافية على Render
DB_CONNECTION=sqlite
# في حال الرغبة بربط PostgreSQL على Render (Render Postgres):
# DB_CONNECTION=pgsql
# DB_HOST=dpg-xxxxxxxx.oregon-postgres.render.com
# DB_PORT=5432
# DB_DATABASE=uot_db
# DB_USERNAME=uot_user
# DB_PASSWORD=your_password

# في حال الرغبة بربط MySQL خارجي:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=uot_science
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
